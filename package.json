{
  "name": "radiant",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:data": "node scripts/build-world.mjs",
    "build:hist": "node scripts/build-panel.mjs && node scripts/build-events.mjs && node scripts/fit-hazards.mjs",
    "forecast": "node scripts/run-forward.mjs --runs 300 --horizon 100",
    "build:ui-data": "node scripts/build-history-slice.mjs && node scripts/build-news.mjs",
    "backtest": "node scripts/backtest.mjs --from 1950 --to 2000 --step 10 --horizon 20 --runs 100 --universe all",
    "build:geo": "node scripts/build-geo.mjs",
    "fetch:wb": "node scripts/fetch-wb.mjs",
    "build": "vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@turf/turf": "^7.4.0",
    "d3": "^7.9.0",
    "playwright-core": "^1.63.0",
    "shapefile": "^0.6.6",
    "svelte": "^5.56.10",
    "topojson-client": "^3.1.0",
    "topojson-server": "^3.0.1",
    "topojson-simplify": "^3.0.3",
    "vite": "^8.2.2",
    "yaml": "^2.9.0"
  }
}
